@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Realestate.Models.Salefeeddummycombo
<!DOCTYPE html>
<html>

<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <title>GP ESTATE</title>

    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.css" />
 
    <!-- fonts style -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:400,700|Raleway:400,700&display=swap" rel="stylesheet">
    <!-- Custom styles for this template -->
    <link href="~/css/style.css" rel="stylesheet" />
  
    <link href="~/css/style.css.map" rel="stylesheet" />
    <!-- responsive style -->
    <link href="~/css/responsive.css" rel="stylesheet" />
 
</head>

<body>
  
    
    <!-- slider section -->
    <section class="slider_section ">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4 offset-md-1">
                    <div class="detail-box">
                        <h1>
                            <span> Easy </span> <br>
                            &nbsp Way To <br>
                            &nbsp;Buy || Sale<br />
                            &nbsp &nbsp Property @ViewBag.bn
                        </h1>
                        <p>
                            It is a Perfect Time to Buy or Sale Your Home.
                        </p>
                        <div class="btn-box">
                            <a href="/Home/Salehome" class="cbz">
                                Sale
                            </a>
                            <a href="/Home/House" class="cbz">
                                Buy
                            </a>
                            @if (TempData["Adminses"] != null)
                            {
                             
                            @* <a href=" /Show/Unsold" class="cbz">
                                Check Status
                            </a> *@
                                 <a href=" /Admin/Dashboard/Unsold" class="cbz">
                            Admin Section
                            </a> 

                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end slider section -->
    

    <!-- find section -->
    <section class="find_section ">
        <div class="container">
            <form action="/Home/Search" method="post">
                <div class=" form-row">
                    <div class="col-md-5">
                        <input type="text" name="Category" class="form-control" placeholder="Property Type Ex.Penthouse">
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="Location" class="form-control" placeholder="City Ex.Mumbai">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="">
                            search
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </section>

    <!-- end find section -->
    <!-- about section -->

    <section class="about_section layout_padding-bottom">
        <div class="square-box">
            <img src="~/images/square.png" alt="">
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="img-box">
                        @{
                            var n = 0;
                            @foreach (var item in Model.SaleHomes){
                                n++;
                                if (n == 1)
                                {
                                    <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" >
                                }
                            }
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="heading_container">
                            <h2>
                                About Our Services
                            </h2>
                        </div>
                        <p>
                            <ul>
                                <li>We Provide Best Properties at low cost as much as possible.</li>
                                <li>We only provide varified properties.</li>
                                <li>Any Time Availabel For Our Valuabel Customers <strong>24*7.</strong> <br /></li>
                                <li>No any hidden terms and condition will be applied to our services</li>
                            </ul>
                        </p>
                        <a href="">
                            Read More
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- end about section -->
    <!-- sale section -->

    <section class="sale_section layout_padding-bottom">
        <div class="container-fluid">
            <div class="heading_container">
                <h2>
                    House For Sale
                </h2>
                <p>
                    Here is an sample for you.
                </p>
            </div>
            <div class="sale_container">
                @{
                    var na = 1;
                    var plo1 = 1;
                    var penth = 1;
                    @foreach (var item in Model.SaleHomes)
                    {
                        
                        if (na <= 3 && item.Property_Type=="Apartment")
                        {
                            na++;
                            <div class="box">
                                <div class="img-box">


                                    <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>


                                </div>
                                <div class="detail-box">
                                    <h6>
                                        @item.Property_Type
                                    </h6>
                                    <p>
                                        @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                                        @Html.DisplayFor(modelItem => item.Property_City)
                                    </p>
                                </div>
                            </div>
                        }
                        
                        if (plo1 <= 3 && item.Property_Type == "Plot")
                        {
                            plo1++;
                            <div class="box">
                                <div class="img-box">


                                    <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>


                                </div>
                                <div class="detail-box">
                                    <h6>
                                        @item.Property_Type
                                    </h6>
                                    <p>
                                        @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                                        @Html.DisplayFor(modelItem => item.Property_City)
                                    </p>
                                </div>
                            </div>
                        }

                       
                            if (penth <= 3 && item.Property_Type == "Penthouse")
                            {
                            penth++;
                                <div class="box">
                                    <div class="img-box">


                                        <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>


                                    </div>
                                    <div class="detail-box">
                                        <h6>
                                            @item.Property_Type
                                        </h6>
                                        <p>
                                            @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                                            @Html.DisplayFor(modelItem => item.Property_City)
                                        </p>
                                    </div>
                                </div>
                            }
                    }
                }
            </div>
            <div class="btn-box">
                <a href="/Home/House" class="cbz">
                    Find More
                </a>
            </div>

    </section>

    <!-- end sale section -->
    <!-- price section -->

