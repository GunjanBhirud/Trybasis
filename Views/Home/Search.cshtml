@model List<Realestate.Models.SaleHome>

<!DOCTYPE html>
<html>

<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <title>GP ESTATE</title>

    <link rel="stylesheet" href="~/SignupLogincss/fonts/material-icon/css/material-design-iconic-font.min.css">
    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.css" />

    <!-- fonts style -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:400,700|Raleway:400,700&display=swap" rel="stylesheet">
    <!-- Custom styles for this template -->
    <link href="~/css/style.css" rel="stylesheet" />
    <!-- responsive style -->
    <link href="~/css/responsive.css" rel="stylesheet" />
    
</head>
<body>
    <section class="sale_section layout_padding">
        
        <div class="social-login" style="width:100%">
           @*  <span class="social-label">Go Back</span> *@
            <ul class="socials" style="position:relative;float:right;margin-right:2rem">
                <li style="list-style:none"><a href="/Home"><i class="display-flex-center zmdi zmdi-home" style="font-size:50px"></i></a></li>

            </ul>
        </div>
               
        <div class="container-fluid">
            <div class="heading_container">
                <h2>
                   Sort Data
                </h2>
                <p>
                   Sorted Result According To Your Data.
                </p>@{
                if (@ViewBag.Pri != null){
                    <p>Below @ViewBag.Pri /-</p>
                }
                }
            </div>
    <div class="sale_container">



                @{



                    foreach (var item in Model)
                    {


                        if (@ViewBag.Pri != null)
                        {
                            
                            if(@ViewBag.Pri > item.Property_Value)
                            {
                                
                                <div class="box">
                                <div class="img-box">
                                    <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>
                                </div>
                                <div class="detail-box">
                                    <h6>
                                        @item.Property_Type
                                    </h6>
                                    <p>
                                        @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                                        @Html.DisplayFor(modelItem => item.Property_City) <br />
                                            <b>Price :</b> @item.Property_Value /-
                                    </p>
                                </div>
                            </div>
                            }

                        }



        
        if (@ViewBag.Cat == @item.Property_Type.ToLower() && @ViewBag.Loc==null)
        {

            <div class="box">
                <div class="img-box">
                <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>
            </div>
            <div class="detail-box">
                <h6>
                    @item.Property_Type
                </h6>
                <p>
                    @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                    @Html.DisplayFor(modelItem => item.Property_City)
                </p>
            </div>
        </div>
        }

        if (@ViewBag.Cat == null && @ViewBag.Loc == @item.Property_City.ToLower())
        {

            <div class="box">
                <div class="img-box">
                    <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>
                </div>
                <div class="detail-box">
                    <h6>
                        @item.Property_Type
                    </h6>
                    <p>
                        @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                        @Html.DisplayFor(modelItem => item.Property_City)
                    </p>
                </div>
            </div>
        }

        if (@ViewBag.Cat == @item.Property_Type.ToLower() && @ViewBag.Loc == @item.Property_City.ToLower())
        {

            <div class="box">
                <div class="img-box">
                    <a href="/Show/Showselected/@item.SaleId"> <img src="~/SaleHomeImage/@Html.DisplayFor(modelItem => item.Property_Image)" alt="" style="height:20rem;"></a>
                </div>
                <div class="detail-box">
                    <h6>
                        @item.Property_Type
                    </h6>
                    <p>
                        @Html.DisplayFor(modelItem => item.Property_Address)&nbsp;
                        @Html.DisplayFor(modelItem => item.Property_City)
                    </p>
                </div>
            </div>
        }


        
    }
    
}
    </div>
        </div>
        </section>
</body>
</html>