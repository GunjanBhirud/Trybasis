@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>@ViewData["Title"] - GP ESTATE</title>

    <!-- Bootstrap core CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.css" asp-append-version="true" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:400,700|Raleway:400,700&display=swap" rel="stylesheet" />
    
    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/Layoutcss.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />

    <style>
        a:hover {
            text-decoration: none;
        }
        a:hover, a:focus {
            color: initial;
        }
        .btn, .btn:focus {
            outline: none !important;
            box-shadow: none;
        }
        .cbz:hover {
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="hero_area">
        <!-- Header section starts -->
        <header class="header_section">
            <div class="container-fluid">
                <nav class="navbar navbar-expand-lg custom_nav-container">
                    <a class="navbar-brand" href="/Home" style="z-index:1;">
                        <img src="@Url.Content("~/images/logoo.png")" alt="Logo" />
                    </a>

                    <div class="navbar-collapse" id="">
                        <ul class="navbar-nav justify-content-between">
                            <div class="User_option" style="position:static;right:120px;top:1px;display:flex;">
                                <li class="nav-link">
                                    @{
                                        if (TempData["Adminses"] != null)
                                        {
                                            <a class="mr-4 cbz" href="/Home/LogoutAdmin">Logout</a>
                                            <a class="mr-4 cbz" href="/Show/NewAdmin">Add Admin</a>
                                        }
                                        else
                                        {
                                            if (ViewBag.ses == null && TempData["Adminses"] == null)
                                            {
                                                <a class="mr-4 cbz" href="/Home/Login">Login</a>
                                            }
                                            else
                                            {
                                                <a class="mr-4 cbz" href="/Home/Logout">Logout</a>
                                            }

                                            <a class="mr-4 cbz" href="/Home/Signup">Sign up</a>
                                            <a class="mr-4 cbz" href="/Home/Admin">Admin</a>
                                        }
                                    }
                                </li>
                            </div>
                        </ul>
                    </div>

                    <div class="custom_menu-btn">
                        <button onclick="openNav()">
                            <span class="s-1"></span>
                            <span class="s-2"></span>
                            <span class="s-3"></span>
                        </button>
                    </div>
                    <div id="myNav" class="overlay">
                        <div class="overlay-content">
                            <a href="/Home" class="cbz">HOME</a>
                            <a href="/Home/About" class="cbz">ABOUT</a>
                            <a href="/Home/House" class="cbz">HOUSE</a>
                            <a href="/Home/Price" class="cbz">PRICING</a>
                            <a href="/Home/Contact" class="cbz">FEEDBACK FORM</a>
                        </div>
                    </div>
                </nav>
            </div>
        </header>
    </div>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
