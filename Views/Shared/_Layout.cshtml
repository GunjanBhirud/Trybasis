                    <div class="navbar-collapse" id="">
                        <ul class="navbar-nav justify-content-between ">
                    <div class="User_option" style="position:static;right:120px;top:1px;display:flex;">
                        <li class="nav-link">
                            @{
                                if (TempData["Adminses"] != null)
                                {
                                        <a class="mr-4 cbz" href="/Home/LogoutAdmin">
                                        Logout
                                    </a>

                                        <a class="mr-4 cbz" href="/Show/NewAdmin">
                                        Add Admin
                                    </a>
                                }
                                    
                                
                                else
                                {
                                            if (ViewBag.ses == null && TempData["Adminses"] == null)
                                    {


                                        <a class="mr-4 cbz" href="/Home/Login" >
                                            Login
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="mr-4 cbz" href="/Home/Logout">
                                            Logout
                                        </a>
                                    }

                                        <a class="mr-4 cbz" href="/Home/Signup">
                                        Sign up
                                        </a>
                                        <a class="mr-4 cbz" href="/Home/Admin" style="">
                                        Admin
                                        </a>
                                }

                            }
                        </li>
                    </div>
                    </ul>
            </div>


                    <div class="custom_menu-btn">
                        <button onclick="openNav()">
                            <span class="s-1">

                            </span>
                            <span class="s-2">

                            </span>
                            <span class="s-3">

                            </span>
                        </button>
                    </div>
                    <div id="myNav" class="overlay">
                <div class="overlay-content">
                    <a href="/Home" class="cbz">HOME</a>
                    <a href="/Home/About" class="cbz">ABOUT</a>
