@model Realestate.Models.SaleHome

@{
    ViewData["Title"] = "Buyhouse";

}
<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link href="~/css/BuyHomedata.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css">

    <style>
        .adj{
            display:flex;
            justify-content:space-around;
         
        }
        .Mode{
margin-left:-16%;
        }
    </style>
</head>
<body>

<div class="container-xl px-4 mt-4">
    <!-- Account page navigation-->
    <nav class="nav nav-borders">
        <a class="nav-link active ms-0" href="https://www.bootdey.com/snippets/view/bs5-edit-profile-account-details" target="__blank">Profile</a>
        <a class="nav-link" href="/Home/Index" >Home</a>
        <a class="nav-link" href="https://www.bootdey.com/snippets/view/bs5-profile-security-page" target="__blank">Security</a>
        <a class="nav-link" href="https://www.bootdey.com/snippets/view/bs5-edit-notifications-page" target="__blank">Notifications</a>
    </nav>
    <hr class="mt-0 mb-4">
    <div class="row">
        <div class="col-xl-4">
            <!-- Profile picture card-->
            <div class="card mb-4 mb-xl-0">
                <div class="card-header">Profile Picture</div>
                <div class="card-body text-center">
                    <!-- Profile picture image-->
                        <img class="img-account-profile  mb-2" src="~/SaleHomeImage/@Model.Property_Image" alt="">
                    <!-- Profile picture help block-->
                    <div class="small font-italic text-muted mb-4">@Model.Property_Type</div>
                    <!-- Profile picture upload button-->
                        <a href="/Home/House" class="btn btn-primary" type="button">Change Property</a>
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <!-- Account details card-->
            <div class="card mb-4">
                <div class="card-header">Property Details</div>
                <div class="card-body">
                    <form action="/Show/BuyAction" method="post">
                       
                        <div class="mb-3">
                            
                                @{
                                    if (@TempData["Adminses"] != null)
                                    {
                                        <label class="small mb-1" for="logmail">Admin Mail Id</label>
                                        <input class="form-control" id="logmail" type="text" value="@TempData["Adminses"]" disabled>
                                    }
                                    else
                                    {
                                        <label class="small mb-1" for="logmail">Logined Mail Id</label>
                                        <input class="form-control" id="logmail" type="text"value="@ViewBag.lgemail" disabled>
                                    }
                                }
                        </div>

                          
                                <input class="form-control" id="img" type="text" name="Property_Image" value="@Model.Property_Image" hidden>
                           
                            
                                <input class="form-control" id="saleid" type="text" value="@Model.SaleId" name="saleid" hidden>
                            
                      
                        <div class="row gx-3 mb-3">
                           
                            <div class="col-md-6">
                                <label class="small mb-1" for="SalerName">Owner Name</label>
                                    <input class="form-control" id="SalerName" type="text" name="Sale_Person_Name" value="@Model.Sale_Person_Name" readonly >
                            </div>
                          
                            <div class="col-md-6">
                                <label class="small mb-1" for="SalerMail">Owner Email</label>
                                    <input class="form-control" id="SalerMail" type="text" name="Sale_Person_Email" value="@Model.Sale_Person_Email" readonly>
                            </div>
                        </div>
                        
                        <div class="row gx-3 mb-3">
                            <!-- Form Group (organization name)-->
                            <div class="col-md-6">
                                <label class="small mb-1" for="SalerContact">Owner Contact No.</label>
                                    <input class="form-control" id="SalerContact" type="text" name="Sale_Person_Number" value="@Model.Sale_Person_Number" readonly >
                            </div>
                            <!-- Form Group (location)-->
                            <div class="col-md-6">
                                <label class="small mb-1" for="PropertyType">Property Type</label>
                                    <input class="form-control" id="PropertyType" type="text" name="Property_Type" value="@Model.Property_Type" readonly >
                            </div>
                        </div>
                        <!-- Form Group (email address)-->
                        <div class="mb-3">
                            <label class="small mb-1" for="PropertyAddress">Property Address</label>
                                <input class="form-control" id="PropertyAddress" type="text" name="Property_Address" value="@Model.Property_Address" readonly >
                        </div>
                        <!-- Form Row-->
                        <div class="row gx-3 mb-3">
                            <!-- Form Group (phone number)-->
                            <div class="col-md-6">
                                    <label class="small mb-1" for="PropertyCity">Property City</label>
                                    <input class="form-control" id="PropertyCity" type="text" name="Property_City"  value="@Model.Property_City" readonly >
                            </div>
                            <!-- Form Group (birthday)-->
                            <div class="col-md-6">
                                    <label class="small mb-1" for="PropertyValue">Property Value</label>
                                    <input class="form-control" id="PropertyValue" type="text" name="Property_Value" value="@Model.Property_Value" readonly >
                            </div>
                        </div>

                            


                                <div class="mb-3 radio" >
                                <label class="small mb-1 form-check-label">Payment Mode</label>
                                    <br />
                                <div class="adj">
                                   
                                    <input type="radio" class="radi" value="Cash" name="Payment_Mode" id="dot-11" required>
                                    <span class="Mode">Cash</span>
                                    
                                    
                                    <input type="radio" class="radi " value="Credit Card" name="Payment_Mode" id="dot-22">
                                    <span class="Mode">Credit Card</span>
                                 
                                   
                                    <input type="radio" class="radi " value="Debit Card" name="Payment_Mode" id="dot-33">
                                    <span class="Mode">Debit Card</span>
                                    
                                </div>
                                </div>

                            <div class="row gx-3 mb-3">

                                <div class="col-md-6">
                                    <label class="small mb-1" for="inputBuyerName">Buyer Name</label>
                                    <input class="form-control" id="inputBuyerName" type="text" placeholder="Enter Buyer Name" name="Buyer_Name" required>
                                </div>

                                <div class="col-md-6">
                                    <label class="small mb-1" for="inputcontact">Buyer Contact No.</label>
                                    <input class="form-control" id="inputcontact" type="tel" placeholder="Enter Contact No." name="Buyer_Phone" required pattern="[0-9]{10}">
                                    
                                </div>
                            </div>




                            <div class="mb-3">
                                <label class="small mb-1" for="inputEmailAddress">Buyer Email</label>
                                <input class="form-control" id="inputEmailAddress" type="email" placeholder="Enter Buyer Mail Id" name="Buyer_Email" required>
                                
                            </div>

                            
                        <!-- Save changes button-->
                        <button  class="btn btn-primary" type="submit">Buy</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
