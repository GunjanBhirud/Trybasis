@model Realestate.Models.DummySaleData


<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link href="~/css/BuyHomedata.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        .adj {
            display: flex;
            justify-content: space-around;
        }

        .Mode {
            margin-left: -16%;
        }
    </style>
</head>
<body>
    
  
    <div class="container-xl px-4 mt-4">
        <!-- Account page navigation-->
        <nav class="nav nav-borders">
            <a class="nav-link active ms-0" href="#">Edit Form</a>
            <a class="nav-link" href="/Home/House">Show Properties</a>
            <a class="nav-link" href="/Home">Home Page</a>
           
            
        </nav>
        <hr class="mt-0 mb-4">
        <form action="/Show/Update" method="post" enctype="multipart/form-data">

                    <div class="row">
                        <div class="col-xl-4">
                           
                            <div class="card mb-4 mb-xl-0">
                                <div class="card-header">Property Picture</div>
                        <a  class="btn btn-primary" type="button"><input class="file" type="file" name="Property_Imagee" id="im"></a>
                                <div class="card-body text-center">
                                   
                                    <img class="img-account-profile  mb-2" src="~/SaleHomeImage/@ViewBag.img" id="imgid" alt="" >
                                  
                                    

                            <div class="small font-italic text-muted mb-4">@Model.Property_Type</div>

                                    <div class="input-box">
                                        <span class="details">Upload Property Image</span>


                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-8">
                           
                            <div class="card mb-4">
                                <div class="card-header">Property Details</div>
                                <div class="card-body">
                                    


                                        <div class="row gx-3 mb-3">

                                            <div class="col-md-6">
                                                <label class="small mb-1" for="Buyer_Id">Buyer Id</label>
                                        <input class="form-control" id="Buyer_Id" type="text" name="Buyer_Id" value="xxx " readonly>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="small mb-1" for="saleid">Sale Id</label>
                                    <input class="form-control" id="saleid" type="text" value="@Model.SaleId" name="SaleId" readonly>
                                            </div>
                                        </div>




                                        <div class="row gx-3 mb-3">

                                            <div class="col-md-6">
                                                <label class="small mb-1" for="SalerName">Owner Name</label>
                                        <input class="form-control" id="SalerName" type="text" name="Sale_Person_Name" value="@Model.Sale_Person_Name" required>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="small mb-1" for="SalerMail">Owner Email</label>
                                    <input class="form-control" id="SalerMail" type="email" name="Sale_Person_Email" value="@Model.Sale_Person_Email" required>
                                            </div>
                                        </div>

                                        <div class="row gx-3 mb-3">
                                           
                                            <div class="col-md-6">
                                                <label class="small mb-1" for="SalerContact">Owner Contact No.</label>
                                    <input class="form-control" id="SalerContact" type="tel" name="Sale_Person_Number" value="@Model.Sale_Person_Number" pattern="[0-9]{10}" required>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="small mb-1" for="PropertyType">Property Type</label>
                                   @*  <input class="form-control" id="PropertyType" type="text" name="Property_Type" value="@Model.Property_Type" required> *@

                                   
                                    <select class="form-control" name="Property_Type" id="PropertyType">
                                        <option value="@Model.Property_Type" selected disabled>@Model.Property_Type</option>
                                        <option value="Apartment">Apartment</option>
                                        <option value="Penthouse">Penthouse</option>
                                        <option value="Plot">Plot</option>
                                    </select>
                                            </div>
                                        </div>
                                       
                                        <div class="mb-3">
                                            <label class="small mb-1" for="PropertyAddress">Property Address</label>
                                <input class="form-control" id="PropertyAddress" type="text" name="Property_Address" value="@Model.Property_Address" required>
                                        </div>
                                      
                                        <div class="row gx-3 mb-3">
                                           
                                            <div class="col-md-6">
                                                <label class="small mb-1" for="PropertyCity">Property City</label>
                                    <select class="form-control" name="Property_City" id="PropertyCity">
                                        <option value="@Model.Property_City"  selected disabled>@Model.Property_City</option>
                                                    <option value="Pune">Pune</option>
                                                    <option value="Mumbai">Mumbai</option>
                                                    <option value="Jalgaon">Jalgaon</option>
                                                </select>
                                               
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <label class="small mb-1" for="PropertyValue">Property Value</label>
                                    <input class="form-control" id="PropertyValue" type="text" name="Property_Value" value="@Model.Property_Value" required>
                                            </div>
                                        </div>
                                <div class="row gx-3 mb-3">
                                <button type="submit" class="form-control btn-info">Submit</button>
                              @*   <a href="/Show/Update/@Model.SaleId" class="form-control btn-info" name="sub" id="sub" style="display:flex ;justify-content:center;text-decoration:none">Submit</a> *@

                                </div>










                                    
                                </div>
                            </div>
                        </div>
                    </div>



        </form>

        
    </div>
 
</body>
</html>
