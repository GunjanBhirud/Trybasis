@model List<Realestate.Models.BuyHome>
<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link href="~/css/BuyHomedata.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css">

    <style>
        .adj {
            display: flex;
            justify-content: space-around;
        }

        .Mode {
            margin-left: -16%;
        }
    </style>
</head>
<body>

    <div class="container-xl px-4 mt-4">
               <nav class="nav nav-borders">
            <a class="nav-link active ms-0" href="/Admin/Dashboard/BuyHomeData">Sold Properties</a>
            @*  <a class="nav-link" href="/Show/Unsold" style="color:red">UnSold Properties</a> *@
            <a class="nav-link" href="/Admin/Dashboard/UnSold" style="color:red">UnSold Properties</a>
            <a class="nav-link" href="/Home/Index">Home Page</a>
            <a class="nav-link " href="" style="margin-left:48%">Total : @ViewBag.Sold</a>
            <a class="nav-link " href="/Admin/Dashboard/VerifySale" style="color:green">
                UnChecked  @{
                    @if (@ViewBag.VerifyC != 0)
                    {
                        <span style="color:red">*</span>
                    }
                }
            </a>
        </nav>
        <hr class="mt-0 mb-4">
        @{
            @foreach (var item in Model)
            {



                <div class="row">
                    <div class="col-xl-4">
                        
                        <div class="card mb-4 mb-xl-0">
                            <div class="card-header">Property Picture</div>
                            <div class="card-body text-center">
                                
                                <img class="img-account-profile  mb-2" src="~/SaleHomeImage/@item.Property_Image" alt="">
                                
                                <div class="small font-italic text-muted mb-4">@item.Property_Type</div>


                            </div>
                        </div>
                    </div>
                    <div class="col-xl-8">
                        
                        <div class="card mb-4">
                            <div class="card-header">Property Details</div>
                            <div class="card-body">
                                <form>


                                    <div class="row gx-3 mb-3">

                                        <div class="col-md-6">
                                            <label class="small mb-1" for="Buyer_Id">Buyer Id</label>
                                            <input class="form-control" id="Buyer_Id" type="text" name="Buyer_Id" value="@item.Buyer_Id" readonly>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="small mb-1" for="saleid">Sale Id</label>
                                            <input class="form-control" id="saleid" type="text" value="@item.SaleId" name="saleid" readonly>
                                        </div>
                                    </div>




                                    <div class="row gx-3 mb-3">

                                        <div class="col-md-6">
                                            <label class="small mb-1" for="SalerName">Owner Name</label>
                                            <input class="form-control" id="SalerName" type="text" name="Sale_Person_Name" value="@item.Sale_Person_Name" readonly>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="small mb-1" for="SalerMail">Owner Email</label>
                                            <input class="form-control" id="SalerMail" type="text" name="Sale_Person_Email" value="@item.Sale_Person_Email" readonly>
                                        </div>
                                    </div>

                                    <div class="row gx-3 mb-3">
                                    
                                        <div class="col-md-6">
                                            <label class="small mb-1" for="SalerContact">Owner Contact No.</label>
                                            <input class="form-control" id="SalerContact" type="text" name="Sale_Person_Number" value="@item.Sale_Person_Number" readonly>
                                        </div>
                                    
                                        <div class="col-md-6">
                                            <label class="small mb-1" for="PropertyType">Property Type</label>
                                            <input class="form-control" id="PropertyType" type="text" name="Property_Type" value="@item.Property_Type" readonly>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="small mb-1" for="PropertyAddress">Property Address</label>
                                        <input class="form-control" id="PropertyAddress" type="text" name="Property_Address" value="@item.Property_Address" readonly>
                                    </div>
                                    
                                    <div class="row gx-3 mb-3">
                                       
                                        <div class="col-md-6">
                                            <label class="small mb-1" for="PropertyCity">Property City</label>
                                            <input class="form-control" id="PropertyCity" type="text" name="Property_City" value="@item.Property_City" readonly>
                                        </div>
                                       
                                        <div class="col-md-6">
                                            <label class="small mb-1" for="PropertyValue">Property Value</label>
                                            <input class="form-control" id="PropertyValue" type="text" name="Property_Value" value="@item.Property_Value" readonly>
                                        </div>
                                    </div>





                                    <div class="mb-3 radio">
                                        <label class="small mb-1 form-check-label">Payment Mode</label>
                                        <br />
                                        <div class="adj">
                                            @if (item.Payment_Mode == "Cash")
                                            {
                                                <input type="radio" class="radi" value="Cash" name="Payment_Mode" id="dot-11" checked readonly>
                                                <span class="Mode">Cash</span>


                                                <input type="radio" class="radi " value="Credit Card" name="Payment_Mode" id="dot-22" disabled>
                                                <span class="Mode">Credit Card</span>


                                                <input type="radio" class="radi " value="Debit Card" name="Payment_Mode" id="dot-33" disabled>
                                                <span class="Mode">Debit Card</span>
                                            }
                                            @if (item.Payment_Mode == "Credit Card")
                                            {
                                                <input type="radio" class="radi" value="Cash" name="Payment_Mode" id="dot-11" disabled>
                                                <span class="Mode">Cash</span>


                                                <input type="radio" class="radi " value="Credit Card" name="Payment_Mode" id="dot-22" checked readonly>
                                                <span class="Mode">Credit Card</span>


                                                <input type="radio" class="radi " value="Debit Card" name="Payment_Mode" id="dot-33" disabled>
                                                <span class="Mode">Debit Card</span>
                                            }
                                            @if (item.Payment_Mode == "Debit Card")
                                            {
                                                <input type="radio" class="radi" value="Cash" name="Payment_Mode" id="dot-11" disabled>
                                                <span class="Mode">Cash</span>


                                                <input type="radio" class="radi " value="Credit Card" name="Payment_Mode" id="dot-22" disabled>
                                                <span class="Mode">Credit Card</span>


                                                <input type="radio" class="radi " value="Debit Card" name="Payment_Mode" id="dot-33" checked readonly>
                                                <span class="Mode">Debit Card</span>
                                            }

                                        </div>
                                    </div>

                                    <div class="row gx-3 mb-3">

                                        <div class="col-md-6">
                                            <label class="small mb-1" for="inputBuyerName">Buyer Name</label>
                                            <input class="form-control" id="inputBuyerName" type="text" placeholder="Enter Buyer Name" name="Buyer_Name" value="@item.Buyer_Name" readonly>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="small mb-1" for="inputcontact">Buyer Contact No.</label>
                                            <input class="form-control" id="inputcontact" type="tel" placeholder="Enter Contact No." name="Buyer_Phone" value="@item.Buyer_Phone" readonly>

                                        </div>
                                    </div>




                                    <div class="mb-3">
                                        <label class="small mb-1" for="inputEmailAddress">Buyer Email</label>
                                        <input class="form-control" id="inputEmailAddress" type="email" placeholder="Enter Buyer Mail Id" name="Buyer_Email" value="@item.Buyer_Email" readonly>

                                    </div>




                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</body>
</html>
